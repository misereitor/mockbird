{
  "name": "mockbird",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/misereitor/mockbird.git"
  },
  "description": "Four Agent Skills that stop AI agents from shipping generic UI: a screen canvas with real interactive HTML mockups, per-project design system, validator and a self-updating OpenCode v2 plugin.",
  "scripts": {
    "test": "node --test plugin/core.test.mjs",
    "smoke": "npm run smoke:plugin",
    "smoke:plugin": "node plugin/smoke.mjs",
    "smoke:screen": "node skills/design/scripts/smoke.mjs --design skills/design/assets/example --config skills/design/assets/validate.config.json",
    "validate": "node skills/design/scripts/validate.mjs --config skills/design/assets/validate.config.json skills/design/assets/example",
    "brief:check": "node skills/design/scripts/validate-brief.mjs",
    "qa": "node skills/design/scripts/qa.mjs --config skills/design/assets/validate.config.json --target skills/design/assets/example",
    "score": "node skills/design/scripts/visual-score.mjs --target skills/design/assets/example",
    "health": "node skills/design/scripts/governance.mjs --target skills/design/assets/example",
    "visual": "node skills/design/scripts/visual-orchestrator.mjs --target skills/design/assets/example",
    "visual:gate": "node skills/design/scripts/visual-gate.mjs --target skills/design/assets/example",
    "contract-test": "node skills/design/scripts/contract-test.mjs --target skills/design/assets/example",
    "security": "node skills/design/scripts/fixtures/security-suite.mjs",
    "check:i18n": "node scripts/i18n-check.mjs",
    "test:mock": "node scripts/mock-check.mjs",
    "test:ui": "node scripts/viewer-accept.mjs",
    "bench:dry": "node benchmarks/run.mjs --dry-run",
    "ci": "npm test && npm run test:mock && npm run smoke:plugin && npm run smoke:screen && npm run test:ui && npm run visual:gate && npm run validate && npm run qa && npm run security && npm run check:i18n",
    "ci:base": "npm test && npm run test:mock && npm run smoke:plugin && npm run visual:gate && npm run validate && npm run qa && npm run security && npm run check:i18n"
  },
  "devDependencies": {
    "playwright-core": "1.64.1"
  }
}
