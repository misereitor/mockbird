{
  "light": {
    "color": {
      "$type": "color",
      "bg": { "$value": "#f8fafc" },
      "surface": { "$value": "#ffffff" },
      "text": { "$value": "#0f172a" },
      "text-muted": { "$value": "#475569" },
      "muted": { "$value": "#475569" },
      "primary": { "$value": "#0f766e" },
      "primary-contrast": { "$value": "#ffffff" },
      "accent": { "$value": "#0f766e" },
      "border": { "$value": "#e2e8f0" },
      "danger": { "$value": "#b91c1c" }
    },
    "space": {
      "$type": "dimension",
      "1": { "$value": "4px" },
      "2": { "$value": "8px" },
      "3": { "$value": "12px" },
      "4": { "$value": "16px" },
      "6": { "$value": "24px" },
      "8": { "$value": "32px" }
    },
    "dimension": {
      "$type": "dimension",
      "space-1": { "$value": "4px" },
      "space-2": { "$value": "8px" },
      "space-3": { "$value": "16px" },
      "space-4": { "$value": "24px" },
      "max-width": { "$value": "1200px" }
    },
    "radius": {
      "$type": "borderRadius",
      "sm": { "$value": "6px" },
      "md": { "$value": "10px" },
      "lg": { "$value": "16px" }
    },
    "borderRadius": {
      "$type": "borderRadius",
      "sm": { "$value": "6px" },
      "md": { "$value": "10px" },
      "lg": { "$value": "16px" }
    },
    "font": {
      "$type": "fontFamily",
      "body": { "$value": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif" }
    },
    "fontSize": {
      "$type": "dimension",
      "sm": { "$value": "14px" },
      "md": { "$value": "16px" },
      "lg": { "$value": "20px" },
      "xl": { "$value": "28px" }
    },
    "typography": {
      "$type": "typography",
      "body": {
        "$value": {
          "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": 1.5
        }
      },
      "heading": {
        "$value": {
          "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
          "fontSize": "28px",
          "fontWeight": 700,
          "lineHeight": 1.2
        }
      }
    },
    "shadow": {
      "$type": "shadow",
      "card": {
        "$value": {
          "color": "#0f172a1a",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "8px",
          "spread": "0px"
        }
      }
    }
  },
  "dark": {
    "color": {
      "$type": "color",
      "bg": { "$value": "#0b1220" },
      "surface": { "$value": "#111a2e" },
      "text": { "$value": "#e2e8f0" },
      "text-muted": { "$value": "#94a3b8" },
      "muted": { "$value": "#94a3b8" },
      "primary": { "$value": "#2dd4bf" },
      "primary-contrast": { "$value": "#042f2e" },
      "accent": { "$value": "#2dd4bf" },
      "border": { "$value": "#1e293b" },
      "danger": { "$value": "#f87171" }
    },
    "space": {
      "$type": "dimension",
      "1": { "$value": "4px" },
      "2": { "$value": "8px" },
      "3": { "$value": "12px" },
      "4": { "$value": "16px" },
      "6": { "$value": "24px" },
      "8": { "$value": "32px" }
    },
    "dimension": {
      "$type": "dimension",
      "space-1": { "$value": "4px" },
      "space-2": { "$value": "8px" },
      "space-3": { "$value": "16px" },
      "space-4": { "$value": "24px" },
      "max-width": { "$value": "1200px" }
    },
    "radius": {
      "$type": "borderRadius",
      "sm": { "$value": "6px" },
      "md": { "$value": "10px" },
      "lg": { "$value": "16px" }
    },
    "borderRadius": {
      "$type": "borderRadius",
      "sm": { "$value": "6px" },
      "md": { "$value": "10px" },
      "lg": { "$value": "16px" }
    },
    "font": {
      "$type": "fontFamily",
      "body": { "$value": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif" }
    },
    "fontSize": {
      "$type": "dimension",
      "sm": { "$value": "14px" },
      "md": { "$value": "16px" },
      "lg": { "$value": "20px" },
      "xl": { "$value": "28px" }
    },
    "typography": {
      "$type": "typography",
      "body": {
        "$value": {
          "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": 1.5
        }
      },
      "heading": {
        "$value": {
          "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
          "fontSize": "28px",
          "fontWeight": 700,
          "lineHeight": 1.2
        }
      }
    },
    "shadow": {
      "$type": "shadow",
      "card": {
        "$value": {
          "color": "#00000066",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "8px",
          "spread": "0px"
        }
      }
    }
  },
  "$extensions": {
    "designPack": {
      "contrastPairs": [
        { "fg": "color.text", "bg": "color.bg", "minRatio": 4.5 },
        { "fg": "color.primary-contrast", "bg": "color.primary", "minRatio": 4.5 },
        { "fg": "color.text-muted", "bg": "color.bg", "minRatio": 3 }
      ]
    }
  }
}
