{
  "light": {
    "color": {
      "$type": "color",
      "bg": { "$value": "#ffffff" },
      "surface": { "$value": "#f4f4f5" },
      "text": { "$value": "#111827" },
      "muted": { "$value": "#6b7280" },
      "accent": { "$value": "#2563eb" },
      "border": { "$value": "#e5e7eb" }
    },
    "dimension": {
      "$type": "dimension",
      "space-1": { "$value": "4px" },
      "space-2": { "$value": "8px" },
      "space-3": { "$value": "16px" },
      "space-4": { "$value": "24px" },
      "max-width": { "$value": "1200px" }
    },
    "typography": {
      "$type": "typography",
      "body": {
        "$value": {
          "fontFamily": "system-ui, sans-serif",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": 1.5
        }
      },
      "heading": {
        "$value": {
          "fontFamily": "system-ui, sans-serif",
          "fontSize": "32px",
          "fontWeight": 700,
          "lineHeight": 1.2
        }
      }
    },
    "shadow": {
      "$type": "shadow",
      "card": {
        "$value": {
          "color": "#0000001a",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "8px",
          "spread": "0px"
        }
      }
    },
    "borderRadius": {
      "$type": "borderRadius",
      "sm": { "$value": "4px" },
      "md": { "$value": "8px" },
      "lg": { "$value": "16px" }
    }
  },
  "dark": {
    "color": {
      "$type": "color",
      "bg": { "$value": "#0b0d12" },
      "surface": { "$value": "#151922" },
      "text": { "$value": "#f3f4f6" },
      "muted": { "$value": "#9ca3af" },
      "accent": { "$value": "#60a5fa" },
      "border": { "$value": "#2a3140" }
    },
    "dimension": {
      "$type": "dimension",
      "space-1": { "$value": "4px" },
      "space-2": { "$value": "8px" },
      "space-3": { "$value": "16px" },
      "space-4": { "$value": "24px" },
      "max-width": { "$value": "1200px" }
    },
    "typography": {
      "$type": "typography",
      "body": {
        "$value": {
          "fontFamily": "system-ui, sans-serif",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": 1.5
        }
      },
      "heading": {
        "$value": {
          "fontFamily": "system-ui, sans-serif",
          "fontSize": "32px",
          "fontWeight": 700,
          "lineHeight": 1.2
        }
      }
    },
    "shadow": {
      "$type": "shadow",
      "card": {
        "$value": {
          "color": "#00000080",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "8px",
          "spread": "0px"
        }
      }
    },
    "borderRadius": {
      "$type": "borderRadius",
      "sm": { "$value": "4px" },
      "md": { "$value": "8px" },
      "lg": { "$value": "16px" }
    }
  },
  "$extensions": {
    "designPack": {
      "contrastPairs": [
        { "fg": "color.text", "bg": "color.bg", "minRatio": 4.5 },
        { "fg": "color.muted", "bg": "color.bg", "minRatio": 3 },
        { "fg": "#ffffff", "bg": "#000000", "minRatio": 21 }
      ]
    }
  }
}
