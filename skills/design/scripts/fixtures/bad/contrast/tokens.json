{
  "light": {
    "color": {
      "$type": "color",
      "bg": { "$value": "#ffffff" },
      "text": { "$value": "#111827" }
    }
  },
  "dark": {
    "color": {
      "$type": "color",
      "bg": { "$value": "#0b0d12" },
      "text": { "$value": "#f3f4f6" }
    }
  },
  "$extensions": {
    "designPack": {
      "contrastPairs": [
        { "fg": "#777", "bg": "#888", "minRatio": 4.5 }
      ]
    }
  }
}
