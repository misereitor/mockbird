{
  "light": {
    "color": {
      "$type": "color",
      "bg": { "$value": "#ffffff" },
      "text": { "$value": "#111827" }
    }
  },
  "dark": {
    "color": {
      "$type": "color",
      "bg": { "$value": "#7f8794" },
      "text": { "$value": "#8a919d" }
    }
  },
  "$extensions": {
    "designPack": {
      "contrastPairs": [
        { "fg": "color.text", "bg": "color.bg", "minRatio": 4.5 }
      ]
    }
  }
}
