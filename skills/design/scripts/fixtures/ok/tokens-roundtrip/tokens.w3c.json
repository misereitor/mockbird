{
  "light": {
    "color": {
      "$type": "color",
      "bg": {
        "$value": "#ffffff"
      },
      "text": {
        "$value": "#111827"
      }
    },
    "dimension": {
      "$type": "dimension",
      "max-width": {
        "$value": "1200px"
      }
    },
    "motion": {
      "easing": {
        "$type": "cubicBezier",
        "standard": {
          "$value": "cubic-bezier(0.2,0,0,1)"
        },
        "decelerate": {
          "$value": "cubic-bezier(0,0,0,1)"
        },
        "accelerate": {
          "$value": "cubic-bezier(0.3,0,1,1)"
        }
      },
      "duration": {
        "$type": "duration",
        "fast": {
          "$value": "120ms"
        },
        "base": {
          "$value": "200ms"
        },
        "slow": {
          "$value": "320ms"
        }
      }
    },
    "density": {
      "$type": "dimension",
      "space-1": {
        "$value": "2px"
      },
      "space-2": {
        "$value": "4px"
      },
      "space-3": {
        "$value": "8px"
      },
      "space-4": {
        "$value": "12px"
      },
      "space-5": {
        "$value": "16px"
      },
      "space-6": {
        "$value": "24px"
      },
      "space-7": {
        "$value": "32px"
      },
      "space-8": {
        "$value": "48px"
      }
    },
    "breakpoints": {
      "$type": "number",
      "sm": {
        "$value": 640
      },
      "md": {
        "$value": 900
      }
    },
    "layers": {
      "$type": "number",
      "base": {
        "$value": 0
      },
      "dropdown": {
        "$value": 100
      },
      "overlay": {
        "$value": 200
      },
      "modal": {
        "$value": 300
      },
      "toast": {
        "$value": 400
      }
    }
  },
